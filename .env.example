# Bu faylning nusxasini `.env` nomi bilan saqlang va qiymatlarni o'zgartiring.
# `.env` fayli git'ga yuklanmaydi (maxfiy).

# Maxfiy kalit. Yangisini yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit-yozing

# Ishlab chiqish paytida True, serverda False
DEBUG=True

# Sayt ochiladigan manzillar (vergul bilan)
ALLOWED_HOSTS=127.0.0.1,localhost

# Serverda HTTPS domen bo'lsa, masalan: https://suv.example.uz
CSRF_TRUSTED_ORIGINS=

# HTTPS ishlatilsa True qiling
SECURE_COOKIES=False

# Sayt nginx (yoki boshqa proksi) orqasida ishlasa True qiling
BEHIND_PROXY=False

# Sayt nomi
SITE_NAME=Nafis

# Ma'lumotlar bazasi: sqlite (odatiy) yoki postgres
DB_ENGINE=sqlite
# PostgreSQL uchun (DB_ENGINE=postgres bo'lganda):
DB_NAME=nafis
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
